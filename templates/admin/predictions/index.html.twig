{% extends 'admin/base.html.twig' %}

{% block body %}
    <div class="container pt-4">
        <div class="row">
            <div class="col">
                <section class="mb-4">
                    <div class="card">
                        <h5 class="card-header">Permutations</h5>
                        <div class="card-body">
                            <form method="GET" action="{{ path('admin_predictions_list') }}">
                                {% set filters = app.request.query.all('filters') %}
                                <div class="row">
                                    <div class="col-lg-3 col-md-6 col-sm">
                                        <div class="form-outline mb-4" data-mdb-input-init>
                                            <select class="form-select form-control-lg" id="filters[season]" name="filters[season]">
                                                <option label="" {% if filters.season is defined and filters.season is empty %}selected{% endif %}>All seasons</option>
                                                {% for season in availableSeasons %}
                                                    <option
                                                        label="{{ season }}"
                                                        {% if (filters.season is not defined and season == 'now'|date('Y')) or (filters.season is defined and filters.season == season) %}selected{% endif %}
                                                    >
                                                        {{ season }}
                                                    </option>
                                                {% endfor %}
                                            </select>
                                        </div>
                                    </div>
                                </div>

                                <div class="row mb-4">
                                    <div class="col">
                                        <button type="submit" class="btn btn-primary" data-mdb-ripple-init>
                                            <i class="fas fa-magnifying-glass me-3"></i>
                                            Filter
                                        </button>
                                    </div>
                                </div>
                            </form>

                            <div class="row">
                                <div class="col">
                                    <table class="table table-striped table-responsive">
                                        <thead>
                                            <tr>
                                                <th>Season</th>
                                                <th>Date</th>
                                                <th>Grand Prix</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for prediction in predictions %}
                                                <tr>
                                                    <td>{{ prediction.race.season.id }}</td>
                                                    <td>{{ prediction.createdAt|date('Y-m-d') }}</td>
                                                    <td>
                                                        {{ prediction.race.grandPrix }}{% if prediction.race.sprintRace %}, Sprint{% endif %}
                                                    </td>
                                                    <td>
                                                        {% if prediction.comparisons is not empty %}
                                                            <a
                                                                href="{{ path('admin_predictions_view', { id: prediction.id }) }}"
                                                                class="btn btn-link btn-sm px-3"
                                                                data-mdb-ripple-init
                                                                data-ripple-color="primary"
                                                            >
                                                                <i class="fas fa-lg fa-eye"></i>
                                                            </a>
                                                        {% else %}
                                                            No permutations.
                                                        {% endif %}
                                                    </td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
{% endblock %}
