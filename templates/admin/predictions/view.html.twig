{% extends 'admin/base.html.twig' %}

{% block body %}
    <div class="container pt-4">
        <div class="row">
            <div class="col">
                <section class="mb-4">
                    <div class="card">
                        <h5 class="card-header">{{ predictionDisplay.leaderName }} will become champion at {{ predictionDisplay.grandPrix }} if...</h5>
                        <div class="card-body">
                            <div class="row">
                                <div class="col">
                                    <table class="table table-striped table-responsive">
                                        <thead>
                                            <tr>
                                                {% for header in predictionDisplay.drivers %}
                                                    <th>{{ header }} finishes</th>
                                                {% endfor %}
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for items in predictionDisplay.items %}
                                                <tr>
                                                    {% for item in items %}
                                                        <td>{{ item.position }}</td>
                                                    {% endfor %}
                                                <tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
{% endblock %}
