<div class="col-lg-6 col-md-12">
    <section class="mb-4">
        <div class="card">
            <h5 class="card-header">Standings</h5>
            <div class="card-body">
                <table class="StandingsTable__Container table table-striped">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Driver</th>
                            <th>Points</th>
                            <th>Diff.</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% set position = 1 %}
                        {% set eliminationBorderSet = false %}

                        {% for standing in standings %}
                            {% set showEliminationBorder = false %}
                            {% if eliminationBorderSet == false and standing.diffToLeader > maxPointsAvailable %}
                                {% set showEliminationBorder = true %}
                                {% set eliminationBorderSet = true %}
                            {% endif %}

                            <tr class="{% if showEliminationBorder %}StandingsTable__EliminationBorder{% endif %}">
                                <td>{{ position }}</td>
                                <td>
                                    <span class="text-muted">#{{ standing.driver.number }}</span> &nbsp; {{ standing.driver.fullName }}
                                </td>
                                <td>{{ standing.seasonPoints }}</td>
                                <td>
                                    <span class="{% if standing.diffToLeader > maxPointsAvailable %}text-white-50{% endif %}">
                                        &ndash;{{ standing.diffToLeader }}
                                    </span>
                                </td>
                            </tr>
                            {% set position = position + 1 %}
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </section>
</div>
